# MIROFORM — environment variables (names only; never commit real values).
# Copy to .env.local for local work; in Vercel set them in Settings → Environment Variables.
# None of them may use the NEXT_PUBLIC_ prefix: all are read on the server only.

# Admin login (/admin). Without both, /admin answers 404.
ADMIN_PASSWORD=            # at least 16 characters
ADMIN_SESSION_SECRET=      # at least 32 random characters; changing it logs every device out

# Supabase (CMS content, drafts, publications, media)
SUPABASE_URL=              # https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=  # publishable / anon key — used by the server for published content only
SUPABASE_SECRET_KEY=       # secret / service_role key — server only, bypasses RLS; never NEXT_PUBLIC_

# Telegram delivery of leads and briefs (/api/lead, /api/brief)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local machine only (migrations, backups, RLS tests) — NOT needed in Vercel
SUPABASE_DB_URL=           # Supabase → Connect → Session pooler URI (TLS verified with supabase/prod-ca-2021.crt)

# Local automated tests against a protected Vercel Preview (optional, never commit)
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional: rate limiting via the Upstash Redis integration (<PREFIX>_REST_API_URL / <PREFIX>_REST_API_TOKEN)
